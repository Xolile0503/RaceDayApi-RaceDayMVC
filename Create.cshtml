@model RaceDayMVC.Models.CreateEventVm
@{
    ViewData["Title"] = "Create Event";
}
<h2>Create New Event</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label>Event Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label>Location</label>
                <input asp-for="Location" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Date & Time</label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" required />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Distance (km)</label>
                    <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Event Type</label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Road">Road</option>
                        <option value="Trail">Trail</option>
                        <option value="Track">Track</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label>Event Banner (Image)</label>
                <input asp-for="Banner" type="file" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-primary">Create Event</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>

            <div class="text-danger mt-2">@Html.ValidationSummary()</div>
        </form>
    </div>
</div>