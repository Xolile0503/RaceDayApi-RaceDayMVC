@model List<RaceDayMVC.Models.EventListVm>
@{
    ViewData["Title"] = "Dashboard";
}
<h2>Organiser Dashboard</h2>

<a asp-action="Create" class="btn btn-success mb-4">+ Create New Event</a>

<div class="row">
    @foreach (var e in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-primary">
                @if (!string.IsNullOrEmpty(e.BannerUrl))
                {
                    <img src="https://localhost:7278@e.BannerUrl" class="card-img-top" style="height:150px; object-fit:cover;" />
                }
                <div class="card-body">
                    <h5 class="card-title">@e.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@e.EventDate.ToString("dd MMM yyyy")</h6>
                    <p class="mb-1">@e.Distance km · @e.EventType</p>
                    <span class="badge bg-primary">@e.RegistrationCount enrolments</span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <h5 class="card-title">@e.Name</h5>
            <h6 class="card-subtitle mb-2 text-muted">@e.EventDate.ToString("dd MMM yyyy")</h6>
            <p class="mb-1">@e.Distance km · @e.EventType</p>
            <span class="badge bg-primary">@e.RegistrationCount enrolments</span>

            <!-- ADD THIS LINK -->
            <div class="mt-3">
                <a asp-action="Enrolments" asp-route-id="@e.RaceEventId" class="btn btn-sm btn-outline-primary w-100">View Enrolments</a>
            </div>
        </div>
    }
</div>