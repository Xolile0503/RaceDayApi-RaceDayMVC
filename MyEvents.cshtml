@model List<RaceDayMVC.Models.RegistrationVm>
@{
    ViewData["Title"] = "My Enrolments";
}
<h2>My Enrolments</h2>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">You haven't enrolled in any events yet.</div>
}
else
{
    <table class="table mt-4">
        <thead>
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Enrolment Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.EventName</td>
                    <td>@r.EventDate?.ToString("dd MMM yyyy")</td>
                    <td>@r.RegistrationDate.ToString("dd MMM yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}